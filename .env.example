# Copy this file to .env and fill in the real password.
# PostgreSQL 连接串：DB 全链路必需；进程环境变量与 .env 均可（环境变量优先）
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/taskboard
# API 监听端口；缺失/非法值由 db.env_int 容错回退默认并打 WARNING
PORT=5000
# 任务租约秒数：worker 心跳每 LEASE_SECONDS//3 秒续租，超期未续由 reaper 收回归队
LEASE_SECONDS=60
# 建连超时（秒）：DB 黑洞时不无限挂起（connect 与连接池同口径）
TB_CONNECT_TIMEOUT=5
# 行锁等待超时（毫秒）：FOR UPDATE 等锁上限
TB_LOCK_TIMEOUT_MS=5000
# 单语句执行超时（毫秒）：SQL 执行时间上限
TB_STATEMENT_TIMEOUT_MS=30000
# 连接池空闲保底连接数（API 读路径/上报路径专用）
TB_POOL_MIN=1
# 连接池并发上限（API 读路径/上报路径专用）
TB_POOL_MAX=8
# watchdog 拉起子进程使用的 Python 解释器；缺省用项目 .venv 内的 python.exe
WATCHDOG_PYTHON=.venv\Scripts\python.exe
# 测试隔离库供给开关：显式设 off（大小写不敏感）跳过隔离供给、退回 skipif 语义；缺省开启
TB_TEST_DB=
# 测试严格模式：设 1 时 DB 不可用的环境大声 pytest.fail（不装绿）；缺省静默降级 skip
TB_STRICT_DB=
# API 访问令牌：非空时 /api 全部请求必须携带 Authorization: Bearer <token>；
# 未设置即全放行（仅限可信本机环境，对外部署必须设置）
API_TOKEN=
# waitress 工作线程数（python -m board.api 优先经 waitress 提供服务）
TB_WSGI_THREADS=8
# 日志文件路径：设置后日志额外以 RotatingFileHandler（10MB×5）追加落盘，stderr 输出不变；缺省仅 stderr
TB_LOG_FILE=
