# Python
__pycache__/
*.py[cod]

# Coverage 运行产物（CI 只出报告不入库）
.coverage

# Virtual environment
.venv/

# Local secrets (use .env.example as template)
.env

# evidence/ 是运行时证据目录（attack_claim 攻击日志、watchdog 重启日志、
# e2e 取证截图等均由运行期产生），不入库；覆盖 .log 与 .png 两类产物，
# _ 前缀临时取证文件一并排除
evidence/_*
evidence/*.log
evidence/*.png
